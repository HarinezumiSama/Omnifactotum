<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net461;net472;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <PropertyGroup>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)'=='net461' or '$(TargetFramework)'=='net472'">
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Appveyor.TestLogger" Version="2.0.0" Condition="$(IsAppveyorBuild)"/>

        <PackageReference Include="coverlet.collector" Version="6.0.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.7.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.7.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.NUnit" Version="1.1.1"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.NUnit" Version="1.1.1"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.NUnit" Version="1.1.1"/>

        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.3.3]" Condition="'$(TargetFramework)'=='netcoreapp2.1' or '$(TargetFramework)'=='net461'"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.13.0]" Condition="'$(TargetFramework)'!='netcoreapp2.1' and '$(TargetFramework)'!='net461'"/>

        <PackageReference Include="NUnit" Version="3.14.0"/>

        <PackageReference Include="NUnit3TestAdapter" Version="[4.3.0]" Condition="'$(TargetFramework)'=='netcoreapp2.1'"/>
        <PackageReference Include="NUnit3TestAdapter" Version="[4.3.2]" Condition="'$(TargetFramework)'=='net461'"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" Condition="'$(TargetFramework)'!='netcoreapp2.1' and '$(TargetFramework)'!='net461'"/>

        <PackageReference Include="PolySharp" Version="1.15.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Omnifactotum.CompilerExtensions\Omnifactotum.CompilerExtensions.csproj"/>
        <ProjectReference Include="..\Omnifactotum.Tests.Common\Omnifactotum.Tests.Common.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- {508349b6-6b84-4df5-91f0-309beebad82d} is for T4 Templates -->
        <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}"/>
    </ItemGroup>

    <PropertyGroup>
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="**/*.cs" Exclude="**/obj/**"/>

        <Compile Include="..\Common\AssemblyInfo.Common.cs">
            <Link>Properties\AssemblyInfo.Common.cs</Link>
        </Compile>

        <None Include="**/*.md"/>

        <None Include="..\Common\Omnifactotum.snk">
            <Link>Properties\Omnifactotum.snk</Link>
        </None>
    </ItemGroup>
</Project>